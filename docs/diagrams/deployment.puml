@startuml
top to bottom direction
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 14
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodeBackgroundColor white
skinparam artifactBackgroundColor white
skinparam databaseBackgroundColor white
skinparam cloudBackgroundColor white
skinparam storageBackgroundColor white
title BrewLite — Triển khai theo cấu hình repository (15/11/2026)

node "Thiết bị khách" as Client {
  artifact "Trình duyệt / PWA" as Browser
}
cloud "DuckDNS\nbrewlite-a2.duckdns.org" as DNS
node "GitHub Actions" as CI {
  artifact "CI dùng chung cho PR và CD\nAPI + Web + Browser E2E fixture" as Checks
  artifact "Gate DB operations\nPostgreSQL test riêng" as DBChecks
  artifact "Build / push image\nDeploy / smoke HTTPS" as Pipeline
  Checks --> Pipeline : phải đạt
  DBChecks --> Pipeline : phải đạt
}
cloud "GHCR\napi / api-migrate / web\ntag = commit SHA" as Registry

node "AWS EC2 Ubuntu — /opt/brewlite" as EC2 {
  node "Docker Compose production" as Compose {
    node "Caddy\n80/TCP, 443/TCP + UDP\nTLS tự động" as Caddy
    node "Next.js Web / BFF\n:3000 nội bộ\n/api/health (?deep=1)" as Web
    node "NestJS API\n:3001 nội bộ\n/health kiểm tra DB" as API
    artifact "Job migration\nkhông seed thường kỳ" as Migrate
    database "PostgreSQL 17\n:5432 nội bộ\nkhông publish port" as DB
    storage "Volume brewlite_pg_data" as Disk
  }
  storage "/srv/brewlite/backups\n.dump + .sha256" as Backup
}
cloud "ZaloPay Sandbox" as ZP
node "Local — compose.yaml" as Local {
  artifact "DB → migrate/seed → API → Web\nAPI/Web chỉ bind loopback" as LocalApp
}

Browser ..> DNS
Browser --> Caddy : HTTPS :443
Pipeline --> Registry : push 3 image
Pipeline ..> EC2 : SSH deploy (:22 mặc định)
Pipeline ..> Caddy : HTTPS smoke
EC2 ..> Registry : pull đúng SHA
Caddy --> Web : các route còn lại\nWeb / BFF / rewrites
Caddy --> API : /health\n/payments/zalopay/callback
Web --> API : HTTP nội bộ\nBFF / rewrites
Migrate --> DB : migration trước cập nhật app
API --> DB : SQL / transaction
DB -- Disk
DB ..> Backup : backup trước migration
API --> ZP : HTTPS tạo / query
ZP --> Caddy : callback HTTPS
Local -[hidden]right-> CI

legend bottom
  .env.prod cấp secret cho đúng dịch vụ; không commit. Log Docker: 10 MB x 3 / service.
  Khách tra cứu DuckDNS trước HTTPS, chuyển sang ZaloPay khi thanh toán thử.
  Chỉ Caddy public port trên Compose production; DNS không chuyển tiếp HTTP.
  CD mới gọi lại CI trong thay đổi local này; cần run GitHub sau khi push được duyệt.
  CI/CD commit nền ab5f05f đã đạt; không thay cho nghiệm thu PWA / Sandbox đầy đủ.
  Deploy: backup → migrate → cập nhật app → smoke HTTPS và kiểm tra cổng DB đóng.
  Rollback image cần schema tương thích; không tự hoàn tác migration.
endlegend
@enduml
