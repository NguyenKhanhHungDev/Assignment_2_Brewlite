# Production environment template for AWS EC2 (/opt/brewlite/.env.prod)
# Never commit real secrets. Generate strong random strings for all secrets.

APP_DOMAIN=your-subdomain.duckdns.org

# PostgreSQL (internal Docker network only, never exposed publicly)
DB_USER=brewlite
DB_PASSWORD=replace-with-strong-db-password
DB_NAME=brewlite_prod

# Application shared secrets (generate with: openssl rand -hex 32)
JWT_SECRET=replace-with-strong-jwt-secret
BFF_PROXY_SECRET=replace-with-strong-bff-proxy-secret
CADDY_PROXY_SECRET=replace-with-strong-caddy-proxy-secret

# Keep false for routine production deploys; set true only if seeding initial menu intentionally.
RUN_SEED=false

# ZaloPay credentials (never commit real or sandbox keys; configure only on EC2)
ZALOPAY_APP_ID=replace-with-zalopay-app-id
ZALOPAY_KEY1=replace-with-zalopay-key1
ZALOPAY_KEY2=replace-with-zalopay-key2
ZALOPAY_API_BASE_URL=https://sb-openapi.zalopay.vn
ZALOPAY_CALLBACK_URL=https://your-subdomain.duckdns.org/payments/zalopay/callback
ZALOPAY_RETURN_URL=https://your-subdomain.duckdns.org/payment/result
